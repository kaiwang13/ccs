{
  "name": "ccs",
  "version": "0.5.1",
  "private": true,
  "description": "ccs: multi-client host for long-lived Claude Code and Codex CLI sessions",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "build:native": "npm --prefix node_modules/nmux run build:native",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/golden/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:golden": "node --test \"test/golden/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:live": "node --test --test-concurrency=1 \"test/live/**/*.test.js\"",
    "nmux:vendor": "sh tools/vendor-nmux.sh",
    "nmux:link": "rm -rf node_modules/nmux && ln -s ../../nmux node_modules/nmux",
    "nmux:vendor-rs": "sh tools/vendor-nmux-rs.sh",
    "nmux:build": "sh tools/build-nmux.sh"
  },
  "dependencies": {
    "nmux": "file:vendor/nmux-0.5.0.tgz",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "acorn": "8.18.0",
    "xterm-cursor": "npm:@xterm/headless@6.1.0-beta.291"
  }
}
